{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["icn1"],
  "crons": [{"path":"/api/ss-runner-cron","schedule":"* * * * *"}],
  "headers": [
    { "source": "/api/(.*)", "headers": [
      { "key": "Cache-Control", "value": "private, no-store" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] }
  ]
}
